# Database
DATABASE_URL=postgresql://chorely:chorely@localhost:5432/chorely

# AI Providers (optional — app works without them)
OPENROUTER_API_KEY=
# Leave blank to use the app default locally and the Docker Compose default in containers.
OLLAMA_BASE_URL=

# Image generation (optional — uses OPENROUTER_API_KEY; override the models if you like).
# These two models drive every image flow: profile avatars, photo avatars, and store items.
# AVATAR_MODEL is used when the user picks "Quality" (slower, sharper)
# AVATAR_MODEL_FAST is used when the user picks "Fast" (~5s, lower fidelity)
# AVATAR_MODEL=openai/gpt-5.4-image-2
AVATAR_MODEL=google/gemini-3.1-flash-image-preview
AVATAR_MODEL_FAST=x-ai/grok-imagine-image-quality

# Mem0 Memory Layer (optional — voice assistant works without it)
MEM0_API_KEY=

# Admin
DEFAULT_ADMIN_PIN=1234
# Minutes before parent admin access requires the PIN again.
ADMIN_PIN_SESSION_TIMEOUT_MINUTES=5

# Voice Providers (optional — only needed if you want ElevenLabs or Bedrock)
ELEVENLABS_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
